# Copy to .env next to docker-compose.yml (do not commit real secrets)
#   copy .env.example .env
#
# Local Maven / IDE (cases-MT):
#   DotEnvEnvironmentPostProcessor loads this file from:
#     1) cases-MT/.env   OR
#     2) Athena-Cases/.env  (when you run from cases-MT)
# Docker Compose injects the same DB_* keys as real environment variables (they win over .env).
#
# DB_PASSWORD must be NON-EMPTY or boot fails fast (avoids PostgreSQL 28P01 auth errors).

SPRING_PROFILES_ACTIVE=dev
MT_HOST_PORT=8090
UI_HOST_PORT=3000
SERVER_PORT=8090

# Full JDBC URL required (reachable from your laptop AND from Docker containers).
# Optional: append ?currentSchema=<schema> to isolate on shared RDS.
# CRITICAL: Hibernate/Flyway AND pgAdmin must use the SAME schema as DB_URL /
# SPRING_FLYWAY_DEFAULT_SCHEMA (e.g. athena_cases_v4). Inspecting a different
# schema (e.g. athena_cases) will show fewer/older rows than the Cases grid.
DB_URL=jdbc:postgresql://insurance-db.cpmmyssa6fll.ap-south-1.rds.amazonaws.com:5432/postgres
DB_USER=postgres
DB_PASSWORD=

# Auth (required in non-dev profiles; application-dev.yml has a local default)
JWT_SECRET=
JWT_ISSUER=athena-cases
JWT_EXPIRATION_MINUTES=480
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
