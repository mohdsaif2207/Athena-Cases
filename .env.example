# Copy to .env next to docker-compose.yml (do not commit real secrets)
#   copy .env.example .env
#
# Local Maven / IDE (cases-MT):
#   DotEnvEnvironmentPostProcessor loads this file from:
#     1) cases-MT/.env   OR
#     2) Athena-Cases/.env  (when you run from cases-MT)
# Docker Compose injects the same DB_* keys as real environment variables (they win over .env).
#
# DB_PASSWORD must be NON-EMPTY or boot fails fast (avoids PostgreSQL 28P01 auth errors).

SPRING_PROFILES_ACTIVE=dev
MT_HOST_PORT=8090
UI_HOST_PORT=3000

# Full JDBC URL required (reachable from your laptop AND from Docker containers)
DB_URL=jdbc:postgresql://insurance-db.cpmmyssa6fll.ap-south-1.rds.amazonaws.com:5432/postgres
DB_USER=postgres
DB_PASSWORD=
